<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<fragment xmlns="http://schemas.haulmont.com/cuba/screen/fragment.xsd">
    <data>
        <collection id="newsDc" class="com.company.untitled16.entity.News">
            <loader id="newsDl">
                <query>
                    <![CDATA[
                        select n from untitled16_News n
                        order by n.publishDate desc
                    ]]>
                </query>
            </loader>
        </collection>
    </data>
    <layout>
        <cssLayout id="header"
                   stylename="news-widget-header">
            <label value="Новости"/>
        </cssLayout>

        <!-- Контейнер для карточек новостей -->
        <vbox id="newsBox"
              spacing="true"
              width="100%"/>
    </layout>
</fragment>
