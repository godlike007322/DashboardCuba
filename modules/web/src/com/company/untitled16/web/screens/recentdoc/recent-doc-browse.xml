<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        xmlns:c="http://schemas.haulmont.com/cuba/screen/jpql_condition.xsd"
        caption="msg://recentDocBrowse.caption"
        focusComponent="recentDocsTable"
        messagesPack="com.company.untitled16.web.screens.recentdoc">
    <data readOnly="true">
        <collection id="recentDocsDc"
                    class="com.company.untitled16.entity.RecentDoc">
            <view extends="_local"/>
            <loader id="recentDocsDl">
                <query>
                    <![CDATA[select e from untitled16_RecentDoc e]]>
                </query>
            </loader>
        </collection>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="recentDocsTable"
            spacing="true">
        <filter id="filter"
                applyTo="recentDocsTable"
                dataLoader="recentDocsDl">
            <properties include=".*"/>
        </filter>
        <groupTable id="recentDocsTable"
                    width="100%"
                    dataContainer="recentDocsDc">
            <actions>
                <action id="create" type="create"/>
                <action id="edit" type="edit"/>
                <action id="remove" type="remove"/>
            </actions>
            <columns>
                <column id="entityName"/>
                <column id="entityId"/>
                <column id="caption"/>
                <column id="visitedTs"/>
            </columns>
            <rowsCount/>
            <buttonsPanel id="buttonsPanel"
                          alwaysVisible="true">
                <button id="createBtn" action="recentDocsTable.create"/>
                <button id="editBtn" action="recentDocsTable.edit"/>
                <button id="removeBtn" action="recentDocsTable.remove"/>
            </buttonsPanel>
        </groupTable>
        <hbox id="lookupActions" spacing="true" visible="false">
            <button action="lookupSelectAction"/>
            <button action="lookupCancelAction"/>
        </hbox>
    </layout>
</window>
