<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://notesEdit.caption"
        focusComponent="form"

        messagesPack="com.company.untitled16.web.screens.notes">
    <data>
        <instance id="notesDc"
                  class="com.company.untitled16.entity.Notes">
            <view extends="_local"/>
            <loader/>
        </instance>
    </data>
    <dialogMode height="600"
                width="800"/>
    <layout expand="editActions" spacing="true">
        <form id="form" dataContainer="notesDc">
            <column width="350px">
                <richTextArea id="textArea" property="text" width="700px"/>
                    <dateField datatype="localDate" id="noteDate" property="noteDate"/>
            </column>
        </form>
        <hbox id="editActions" spacing="true">
            <button id="commitAndCloseBtn" action="windowCommitAndClose"/>
            <button id="closeBtn" action="windowClose"/>
        </hbox>
    </layout>
</window>
