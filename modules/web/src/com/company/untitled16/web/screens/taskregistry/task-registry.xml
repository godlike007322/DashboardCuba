<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<window xmlns="http://schemas.haulmont.com/cuba/screen/window.xsd"
        caption="msg://taskRegistry.caption"
        focusComponent="projectNumberField"
        messagesPack="com.company.untitled16.web.screens.taskregistry">
    <data readOnly="true">
        <keyValueCollection id="tasksDc">
            <properties>
                <property name="projectNumber" datatype="string"/>
                <property name="registrationNumber" datatype="string"/>
                <property name="description" datatype="string"/>
                <property name="taskType" datatype="string"/>
                <property name="initiator" datatype="string"/>
                <property name="assignee" datatype="string"/>
                <property name="status" datatype="string"/>
                <property name="deadline" datatype="string"/>
                <property name="overdue" datatype="boolean"/>
            </properties>
        </keyValueCollection>
    </data>
    <dialogMode width="1200" height="760"/>
    <layout stylename="task-registry-screen" expand="registryRoot">
        <hbox id="registryRoot" stylename="task-registry-root" width="100%" height="100%" spacing="false" expand="contentScroll">
            <vbox id="sideMenu" stylename="task-registry-side" width="250px" height="100%" spacing="false">
                <label value="ЗАДАЧИ" stylename="task-side-group-title"/>
                <button id="currentTasksBtn" caption="Текущие" stylename="task-side-item task-side-item-active"/>
                <button id="completedByMeBtn" caption="Завершенные мной" stylename="task-side-item"/>
                <button id="assignedByMeBtn" caption="Назначенные мной" stylename="task-side-item"/>
                <button id="overdueBtn" caption="Просроченные" stylename="task-side-item task-side-item-danger"/>
                <button id="archiveBtn" caption="Архив" stylename="task-side-item"/>

                <label value="ТИП ЗАДАЧИ" stylename="task-side-group-title task-side-group-title-second"/>
                <button id="allTypesBtn" caption="Все типы" stylename="task-side-item"/>
                <button id="ordersBtn" caption="Поручения" stylename="task-side-item"/>
                <button id="approvalsBtn" caption="Согласования" stylename="task-side-item task-side-item-active"/>
                <button id="readingsBtn" caption="Ознакомления" stylename="task-side-item"/>
                <button id="signingBtn" caption="Подписание" stylename="task-side-item"/>
            </vbox>

            <scrollBox id="contentScroll" stylename="task-registry-content" width="100%" height="100%">
                <vbox id="content" width="100%" spacing="true">
                    <label value="Реестр задач" stylename="task-registry-title"/>

                    <vbox id="filtersCard" stylename="task-card task-filters-card" width="100%" spacing="true">
                        <label value="Фильтры" stylename="task-card-title"/>
                        <grid id="filtersGrid" columns="4" spacing="true" width="100%">
                            <textField id="projectNumberField" caption="Проектный номер" inputPrompt="Например, PRJ-2026" width="100%"/>
                            <textField id="registrationNumberField" caption="Рег. номер" inputPrompt="TASK-0001" width="100%"/>
                            <textField id="descriptionField" caption="Описание" inputPrompt="Ключевые слова" width="100%"/>
                            <textField id="initiatorField" caption="Инициатор" inputPrompt="ФИО" width="100%"/>
                            <textField id="assigneeField" caption="Исполнитель" inputPrompt="ФИО" width="100%"/>
                            <dateField id="dateFromField" caption="Дата с" width="100%"/>
                            <dateField id="dateToField" caption="Дата по" width="100%"/>
                        </grid>
                        <hbox id="filterActions" spacing="true">
                            <button id="searchBtn" caption="Найти" stylename="primary task-action-primary"/>
                            <button id="resetBtn" caption="Сбросить"/>
                            <button id="moreFiltersBtn" caption="Еще фильтры" stylename="task-link-button"/>
                        </hbox>
                        <hbox id="activeFilters" stylename="task-chips" spacing="true">
                            <label value="Текущие" stylename="task-chip"/>
                            <label value="Согласования" stylename="task-chip task-chip-blue"/>
                        </hbox>
                    </vbox>

                    <hbox id="counters" stylename="task-counters" width="100%" spacing="true">
                        <vbox stylename="task-counter-card" width="25%" spacing="false">
                            <label value="Всего" stylename="task-counter-caption"/>
                            <label id="totalCounter" value="8" stylename="task-counter-value"/>
                        </vbox>
                        <vbox stylename="task-counter-card task-counter-card-blue" width="25%" spacing="false">
                            <label value="В работе" stylename="task-counter-caption"/>
                            <label id="inProgressCounter" value="4" stylename="task-counter-value"/>
                        </vbox>
                        <vbox stylename="task-counter-card task-counter-card-red" width="25%" spacing="false">
                            <label value="Просрочено" stylename="task-counter-caption"/>
                            <label id="overdueCounter" value="2" stylename="task-counter-value"/>
                        </vbox>
                        <vbox stylename="task-counter-card task-counter-card-green" width="25%" spacing="false">
                            <label value="Завершено" stylename="task-counter-caption"/>
                            <label id="completedCounter" value="2" stylename="task-counter-value"/>
                        </vbox>
                    </hbox>

                    <vbox id="tableCard" stylename="task-card task-table-card" width="100%" spacing="true">
                        <hbox id="toolbar" stylename="task-toolbar" width="100%" spacing="true">
                            <button id="createTaskBtn" caption="Создать задачу" stylename="primary task-action-primary"/>
                            <button id="openTaskBtn" caption="Открыть"/>
                            <button id="assignTaskBtn" caption="Назначить"/>
                            <button id="changeStatusBtn" caption="Изменить статус"/>
                            <button id="exportBtn" caption="Экспорт" stylename="task-toolbar-export"/>
                        </hbox>
                        <groupTable id="tasksTable" width="100%" height="420px" dataContainer="tasksDc" stylename="task-registry-table">
                            <columns>
                                <column id="projectNumber" caption="Проектный номер"/>
                                <column id="registrationNumber" caption="Рег. номер"/>
                                <column id="description" caption="Описание"/>
                                <column id="taskType" caption="Тип задачи"/>
                                <column id="initiator" caption="Инициатор"/>
                                <column id="assignee" caption="Исполнитель"/>
                                <column id="status" caption="Статус"/>
                                <column id="deadline" caption="Срок"/>
                            </columns>
                            <rowsCount/>
                        </groupTable>
                    </vbox>
                </vbox>
            </scrollBox>
        </hbox>
    </layout>
</window>
